/* polkit rule for wireguard-gui.
 *
 * Lets a user who is BOTH in an active local session AND a member of the
 * "wireguard" group run the wg-helper through pkexec without a password. The
 * group requirement is essential: the helper can read /etc/wireguard configs
 * (which contain private keys), so it must NOT be exposed to every active-local
 * user. install.sh --polkit creates the group and adds the intended user;
 * distro packages only install this rule and need administrator-managed group
 * membership. A new login is needed after changing membership. Outside these
 * checks this rule grants nothing; pkexec may request administrator credentials.
 * The sudoers drop-in is the installer default. Requires polkit JS rules.
 */
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        (action.lookup("program") === "/usr/local/lib/wireguard-gui/wg-helper" ||
         action.lookup("program") === "/usr/lib/wireguard-gui/wg-helper") &&
        subject.local && subject.active && subject.isInGroup("wireguard")) {
        return polkit.Result.YES;
    }
});
