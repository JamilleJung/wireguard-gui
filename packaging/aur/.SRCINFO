pkgbase = wireguard-gui
	pkgdesc = A native Linux GUI for managing plain WireGuard tunnels with wg and wg-quick
	pkgver = 1.9.3
	pkgrel = 1
	url = https://github.com/JamilleJung/wireguard-gui
	install = wireguard-gui.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	depends = glibc
	depends = libgcc
	depends = fontconfig
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrender
	depends = libxcb
	depends = dbus
	depends = wireguard-tools
	depends = iproute2
	depends = polkit
	optdepends = nftables: kill switch (preferred over the iptables fallback)
	optdepends = openresolv: resolvconf for configs with a DNS line
	optdepends = sudo: sudoers-based helper authorization instead of polkit
	optdepends = xdg-desktop-portal: native file dialogs for import and backup
	optdepends = minisign: verify release signatures
