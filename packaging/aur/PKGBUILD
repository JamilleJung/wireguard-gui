# Maintainer: jamillejung <izeystudio@gmail.com>
pkgname=wireguard-gui
pkgver=1.10.0
pkgrel=1
pkgdesc="A native Linux GUI for managing plain WireGuard tunnels with wg and wg-quick"
arch=('x86_64' 'aarch64')
url="https://github.com/JamilleJung/wireguard-gui"
license=('MIT')
# fontconfig is linked; xkbcommon, Wayland, EGL/GL (libglvnd), X11 and libdbus
# are loaded at run time, so they are listed explicitly. The privileged helper
# runs wg/wg-quick (which need ip from iproute2); the kill switch uses nftables,
# falling back to iptables (pulled in by iproute2). Passwordless polkit access
# also needs administrator-managed membership in the wireguard group.
depends=('glibc' 'libgcc' 'fontconfig' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
         'libglvnd' 'libx11' 'libxcursor' 'libxi' 'libxrender' 'libxcb' 'dbus'
         'wireguard-tools' 'iproute2' 'polkit'
         'hicolor-icon-theme')
makedepends=('cargo')
# The helper's process tests spawn python3; the UI tests render text and need
# a font.
checkdepends=('python' 'ttf-dejavu')
optdepends=('nftables: kill switch (preferred over the iptables fallback)'
            'openresolv: resolvconf for configs with a DNS line'
            'sudo: sudoers-based helper authorization instead of polkit'
            'xdg-desktop-portal: native file dialogs for import and backup'
            'minisign: verify release signatures')
install=wireguard-gui.install
# Cargo's release profile already strips the binaries; a debug package would
# hold only dangling build-id links.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d003ba94fae937e3d6e8a6af560e3e8e73131bdd9b2fc0462dd28fa78f14e12e')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/wireguard-gui "$pkgdir/usr/bin/wireguard-gui"
    install -Dm755 target/release/wg-helper "$pkgdir/usr/lib/$pkgname/wg-helper"
    install -Dm644 packaging/wireguard-gui.desktop "$pkgdir/usr/share/applications/wireguard-gui.desktop"
    install -Dm644 packaging/wireguard-gui.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/wireguard-gui.svg"
    install -Dm644 packaging/49-wireguard-gui.rules "$pkgdir/usr/share/polkit-1/rules.d/49-wireguard-gui.rules"
    # Tells the in-app updater that pacman owns this copy.
    printf 'format=1\napp=%s\nmethod=package\nmanager=pacman\n' "$pkgname" \
        > "$pkgdir/usr/lib/$pkgname/install-manifest"
    chmod 644 "$pkgdir/usr/lib/$pkgname/install-manifest"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
