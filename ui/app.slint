// Entry point compiled by build.rs. The UI is split into components:
//   theme.slint       colour/focus/glyph tokens (default, high contrast, ASCII)
//   widgets.slint     keyboard-accessible buttons, rows, fields, banners
//   main_window.slint the main window
//   editor.slint      the tunnel editor
//   dialogs.slint     QR, diagnostics, Help, Updates, About, Setup

export { Theme, TooltipState } from "theme.slint";
export { DocItem } from "widgets.slint";
export { MainWindow, TunnelItem, PeerInfo, BackupRow, TunnelDetail } from "main_window.slint";
export { EditWindow } from "editor.slint";
export { QrWindow, DiagWindow, HelpWindow, UpdateWindow, AboutWindow, SetupWindow, CheckItem } from "dialogs.slint";
